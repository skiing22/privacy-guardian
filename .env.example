# Copy to .env for local runs. Never commit .env. Full list: docs/API.md section 10.
# In dev, everything below is optional; leave the four keys empty to use fixed DEV keys.

ENV=dev                                   # dev | prod (prod refuses DEV keys and http origins)
PUBLIC_ORIGIN=http://localhost:8000       # prod: your https:// address
# Production VM only (docker-compose.prod.yml): the domain Caddy gets a certificate for.
# It also sets ENV=prod and PUBLIC_ORIGIN=https://$DOMAIN there, overriding the two lines above.
DOMAIN=
DATA_DIR=../.data                         # local runs from backend/; the container uses /data
LOG_LEVEL=INFO

# NER model folder for LOCAL runs (the image always uses /app/model)
NER_MODEL_PATH=../ml/models/ner-distilbert-v1
NER_THRESHOLD=0.5

MAX_UPLOAD_MB=10
RETENTION_DAYS=7
SESSION_IDLE_HOURS=8
SESSION_MAX_DAYS=7
TRUSTED_PROXY_COUNT=0

# Keys (ADR-0020, ADR-0022 D15): four DIFFERENT keys, each 32+ bytes of hex. Generate each:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotation: append a new key, keep old ones for old data:  PG_TOKEN_KEY=k1:<old>,k2:<new>
PG_TOKEN_KEY=
PG_AUDIT_KEY=
PG_VAULT_KEY=
PG_STORAGE_KEY=

# First admin, created once at first start if no users exist (P5). Remove after first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Image build only (API 8.2, D16). Not secret; read by docker compose build. ----
# MODEL_SOURCE=hf uses the private repo below; MODEL_SOURCE=fake builds a tiny random model
# (CI, trying the image). The TOKEN is never here: put it in .secrets/hf_token (git-ignored),
# a read-only token from https://huggingface.co/settings/tokens
MODEL_SOURCE=hf
MODEL_REPO=
MODEL_REVISION=                           # 40-character commit hash, not "main"
MODEL_SHA256=                             # from: python backend/scripts/model_fetch.py hash <folder>
