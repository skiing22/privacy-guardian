# Copy to .env. Never commit .env.
ENV=dev
DATABASE_URL=postgresql+psycopg://pg:pg@localhost:5432/privacy_guardian

# NER model folder (download from Google Drive into ml/models/)
NER_MODEL_PATH=../ml/models/ner-distilbert-v1
NER_THRESHOLD=0.5

# Crypto keys (used from M4). Generate each with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PG_TOKEN_KEY=
PG_AUDIT_KEY=
PG_VAULT_KEY=
